{
  "expo": {
    "name": "THE UNKNOWN",
    "slug": "the-unknown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theunknown.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "THE UNKNOWN uses the microphone to record voice posts and voice messages.",
        "NSPhotoLibraryUsageDescription": "THE UNKNOWN lets you attach photos to posts and messages."
      }
    },
    "android": {
      "package": "com.theunknown.app",
      "adaptiveIcon": {
        "backgroundColor": "#168AF7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#168AF7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "THE UNKNOWN uses the microphone to record voice posts."
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "THE UNKNOWN lets you add photos to your profile, posts and chats.",
          "cameraPermission": "THE UNKNOWN uses the camera for your verification selfie and photos you choose to share."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "THE UNKNOWN uses your approximate area only when you turn on People Nearby. Your exact position is never shown to anyone.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "scheme": "theunknown",
    "backgroundColor": "#168AF7",
    "experiments": {
      "typedRoutes": false
    }
  }
}
