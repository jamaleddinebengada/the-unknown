# Copy to .env and fill in from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only (never put these in the app):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...        (AI assist edge function)
# UNKNOWN PLUS subscriptions (RevenueCat public SDK keys — safe in the app):
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Server-side: supabase secrets set REVENUECAT_WEBHOOK_AUTH=<same value as the RevenueCat webhook Authorization header>
